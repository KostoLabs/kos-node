# ============================================================
# arion-elements-node — variables d'environnement (EXEMPLE)
#
# Copier ce fichier vers `.env` (ignoré par git) puis adapter :
#   cp .env.example .env
#
# AUCUN secret ne doit être commité : `.env` est dans .gitignore.
# ============================================================

# ------------------------------------------------------------
# Docker Compose
# ------------------------------------------------------------
# Profil actif par défaut : `dev` (nœud regtest + explorateur).
# Le profil `prod-template` est un squelette : voir README §Fédération.
COMPOSE_PROFILES=dev
COMPOSE_PROJECT_NAME=arion-elements

# ------------------------------------------------------------
# Elements Core
# ------------------------------------------------------------
# Version épinglée d'Elements Core (voir docker/elements/Dockerfile :
# l'empreinte SHA256 du binaire doit correspondre à cette version).
ELEMENTS_VERSION=23.3.3

# Miroir de téléchargement des binaires officiels. Pour la certification
# souveraineté, pointer vers votre dépôt d'artefacts interne (Nexus,
# Artifactory…) hébergé en FR/UE :
# ELEMENTS_DOWNLOAD_BASE=https://artifacts.exemple.fr/elements/releases/download
ELEMENTS_DOWNLOAD_BASE=https://github.com/ElementsProject/elements/releases/download

# ------------------------------------------------------------
# RPC — profil dev
# ------------------------------------------------------------
# Identifiants RPC injectés au démarrage du démon (jamais écrits dans un
# fichier commité). CHANGEZ le mot de passe, même en dev.
ELEMENTS_RPC_USER=arion
ELEMENTS_RPC_PASSWORD=change-me-please

# Port RPC publié sur l'hôte (127.0.0.1 uniquement).
# 18884 = continuité avec l'existant.
ELEMENTS_RPC_PORT=18884

# Nom de la chaîne dev. `elementsregtest` par défaut.
# (`liquidregtest` est fonctionnellement identique — mêmes paramètres par
# défaut — et peut être utilisé si un outil tiers l'exige.)
ELEMENTS_DEV_CHAIN=elementsregtest

# Nom du wallet créé/chargé automatiquement par `make up`.
ELEMENTS_WALLET=main

# ------------------------------------------------------------
# Explorateur — electrs (indexeur + API REST) et esplora (UI web)
# ------------------------------------------------------------
# Images par défaut : builds publics de Vulpem Ventures (utilisés par
# l'outillage Nigiri ; AUCUN service Blockstream n'est appelé).
# Pour un build 100 % auto-hébergé : voir docker/electrs/Dockerfile et
# pointer ces variables vers votre registre interne.
ELECTRS_IMAGE=ghcr.io/vulpemventures/electrs-liquid:latest
ESPLORA_IMAGE=ghcr.io/vulpemventures/esplora:latest

# Ports publiés sur l'hôte (127.0.0.1 uniquement)
ELECTRS_REST_PORT=3002
ELECTRS_ELECTRUM_PORT=50001
ESPLORA_UI_PORT=5001

# ------------------------------------------------------------
# Supervision (scripts/healthcheck.sh)
# ------------------------------------------------------------
# Hauteur de chaîne minimale attendue (0 = pas de contrôle).
HEALTH_MIN_HEIGHT=0
# Âge maximal du dernier bloc en secondes (0 = désactivé ; en dev les blocs
# sont minés à la demande, laisser 0. En prod : ~10x l'espacement cible).
HEALTH_MAX_BLOCK_AGE=0
# Seuils d'occupation disque du datadir (%).
HEALTH_DISK_WARN=80
HEALTH_DISK_CRIT=90
# Nombre minimal de pairs (0 en dev, >= 2 recommandé en prod).
HEALTH_MIN_PEERS=0

# ------------------------------------------------------------
# Profil prod-template — chaîne fédérée « kosto »
# ------------------------------------------------------------
# ATTENTION : ces valeurs figent le genesis. Voir README §Fédération pour
# la procédure complète (génération des clés, assemblage du multisig,
# cérémonie de démarrage). Ne JAMAIS inventer ces valeurs à la main.
KOSTO_CHAIN_NAME=kosto
# Script multisig K-de-N produit par scripts/federation/assemble-signblockscript.py
KOSTO_SIGNBLOCKSCRIPT=
# Taille max. du témoin de signature de bloc (recommandation donnée par le
# même script).
KOSTO_MAX_BLOCK_SIG_SIZE=
# Espacement cible des blocs, en secondes.
KOSTO_BLOCK_SPACING=60
# Ports du nœud prod
KOSTO_RPC_PORT=7041
KOSTO_P2P_PORT=7042
# Ligne rpcauth (générée par share/rpcauth/rpcauth.py des sources
# d'Elements Core — hash salé, le mot de passe n'apparaît jamais).
# Format : user:salt$hash — ATTENTION : échapper chaque `$` en `$$`
# dans ce fichier (interpolation docker compose).
# Exemple : KOSTO_RPCAUTH=kosto:1c9f2f$$d5b2ee…
KOSTO_RPCAUTH=
